# mediamtx configuration file

rtsp: true
rtspTransports: [tcp, udp]

rtmp: false
hls: false
webrtc: false
srt: false
moq: false

logLevel: info

# if USB deconnects and /dev/video0 isn't available: `sudo usbreset "USB2.1 Hub"`
paths:
  ch0_0:
    runOnInit: >
      gst-launch-1.0 -q v4l2src device=$VIDEO_DEVICE do-timestamp=true
        ! image/jpeg,width=1920,height=1080,framerate=${FRAMERATE}/1
        ! tee name=t
        t. ! queue max-size-buffers=3 leaky=downstream
           ! capssetter caps="image/jpeg,colorimetry=(string)bt601" ! jpegparse
           ! v4l2jpegdec
           ! v4l2h264enc extra-controls="controls,video_bitrate=${BITRATE_BPS},h264_i_frame_period=${KEYINT}"
           ! video/x-h264,level=(string)4 ! h264parse config-interval=-1
           ! rtspclientsink location=rtsp://localhost:8554/ch0_0 protocols=tcp
        t. ! queue leaky=downstream max-size-buffers=2
           ! videorate drop-only=true ! image/jpeg,framerate=1/10
           ! multifilesink location=/usr/local/www/ch0_0.jpg
    runOnInitRestart: true
