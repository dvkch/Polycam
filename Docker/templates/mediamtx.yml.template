# mediamtx configuration file

rtsp: yes
protocols: [tcp, udp]

rtmp: no
hls: no
webrtc: no
srt: no

logLevel: info

# if USB deconnects and /dev/video0 isn't available: `sudo usbreset "USB2.1 Hub"`
paths:
  ch0_0:
    runOnInit: >
      ffmpeg -loglevel error -f v4l2 -input_format mjpeg -video_size 1920x1080 -framerate 30 -i /dev/video0
        -c:v h264_v4l2m2m -pix_fmt yuv420p -b:v 4M -g 60
        -f rtsp -rtsp_transport tcp rtsp://localhost:8554/ch0_0
    runOnInitRestart: yes
    runOnReady: sh -c "while true; do ffmpeg -hide_banner -loglevel error -y -i rtsp://localhost:8554/ch0_0 -frames:v 1 /usr/local/www/ch0_0.jpg; sleep 60; done"
    runOnReadyRestart: yes
